{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "claude-opus-5-5",
    "effortLevel": "high",
    "permissions": {
        "allow": [
			"Read(./.ai/project/**)",
			"Edit(./.ai/project/**)",
            "Bash(git status *)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git show *)",
            "Bash(git rev-parse *)",
            "Bash(git ls-files *)"
        ],
        "deny": [
			"Read(./.ai/prompts/**)",
			"Edit(./.ai/prompts/**)",
            "Edit(./**/.git/**)",
			"Bash(git push *)"
        ]
    }
}