# An ignore rule is not an access control: agents and tools can still read ignored files.

# Personal and local agent files
.claude/settings.local.json
CLAUDE.local.md
.claude/worktrees/

# Environment files
.env
.env.*
!.env.example

# Python tooling
.venv/
__pycache__/
*.py[cod]

# Built output: decks, PDFs, previews, delivery archives, tool caches (never committed or published: decision 0021)
/build/

# Delivery data: specific to one organization and one delivery, never committed (decision 0021)
/deliveries/*
!/deliveries/README.md
!/deliveries/example.toml

# Safety net: built files belong in /build/ only
*.pdf
*.pptx
*.odp
*.zip

# Office lock and temporary files
~$*
.~lock.*#
*.tmp

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating systems
.DS_Store
Thumbs.db
desktop.ini
.directory
